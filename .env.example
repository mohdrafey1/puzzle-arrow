# Firebase Realtime Database configuration.
# Copy this file to `.env` and fill in the values from your Firebase project
# settings (Project settings → General → Your apps → SDK setup and configuration).
#
# These are EXPO_PUBLIC_* vars, so they are embedded in the client bundle — that
# is expected for Firebase web config. Security is enforced by the Realtime
# Database rules (see database.rules.json), NOT by keeping these secret.
#
# Without these set, community levels and the leaderboard will silently fail.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
