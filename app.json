{
    "expo": {
        "name": "Puzzle Arrow",
        "slug": "puzzle-arrow",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icons/android-chrome-512x512.png",
        "scheme": "puzzlearrow",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#ffffff",
                "foregroundImage": "./assets/icons/android-chrome-512x512.png"
            },
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false,
            "package": "com.mohdrafey1.puzzlearrow"
        },
        "web": {
            "output": "static",
            "favicon": "./assets/icons/favicon-32x32.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/icons/android-chrome-512x512.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff",
                    "dark": {
                        "backgroundColor": "#000000"
                    }
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "ca580f59-5a02-40e0-a598-7500e308d0af"
            }
        }
    }
}
