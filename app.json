{
    "expo": {
        "name": "Puzzle Arrow",
        "slug": "puzzle-arrow",
        "version": "1.1.3",
        "icon": "./assets/icons/android-chrome-512x512.png",
        "scheme": "puzzlearrow",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#ffffff",
                "foregroundImage": "./assets/icons/android-chrome-512x512.png"
            },
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false,
            "package": "com.mohdrafey1.puzzlearrow",
            "permissions": [
                "android.permission.INTERNET",
                "android.permission.MODIFY_AUDIO_SETTINGS",
                "android.permission.READ_EXTERNAL_STORAGE",
                "android.permission.VIBRATE",
                "android.permission.WRITE_EXTERNAL_STORAGE"
            ]
        },
        "web": {
            "output": "static",
            "favicon": "./assets/icons/favicon-32x32.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/icons/android-chrome-512x512.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff",
                    "dark": {
                        "backgroundColor": "#000000"
                    }
                }
            ],
            [
                "expo-audio",
                {
                    "microphonePermission": false
                }
            ],
            [
                "react-native-google-mobile-ads",
                {
                    "androidAppId": "ca-app-pub-4435788387381825~5315581090"
                }
            ],
            "expo-asset"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "ca580f59-5a02-40e0-a598-7500e308d0af"
            }
        },
        "runtimeVersion": {
            "policy": "appVersion"
        },
        "updates": {
            "url": "https://u.expo.dev/ca580f59-5a02-40e0-a598-7500e308d0af",
            "fallbackToCacheTimeout": 3000
        }
    }
}
